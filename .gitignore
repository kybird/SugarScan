# --- sugarScan ---
# OCR 학습 자산: 저장소에 직접 넣지 않는다 (Git LFS 또는 별도 스토리지)
# 대용량 데이터셋·모델·캐시는 저장소에 넣지 않는다.
assets_dev/
# 다만 **라벨링 도구와 사람이 만든 라벨은 소스다.** 버전 관리 밖에 두었더니
# "고친 코드가 실제로 돌고 있느냐"를 확인할 방법이 없었고, 좌표 파손 사고가
# 언제 어느 빌드에서 들어왔는지 되짚을 수도 없었다(2026-09-02).
!assets_dev/
assets_dev/*
!assets_dev/train/
assets_dev/train/*
!assets_dev/train/*.py
!assets_dev/train/*.html
!assets_dev/train/*.bat
!assets_dev/train/*.md
# 실사진 기준선 정본 — make_real_baseline.py 가 라벨에서 생성한다. 세 소비처
# (synth_panel·validate_synth_panel·GLM_TASKS 3.8)가 읽는 살아 있는 입력이라
# 저장소에 있어야 한다(손으로 편집 금지 — 생성기로만 갱신).
!assets_dev/train/real_baseline.json
!assets_dev/train/labeled.jsonl
!assets_dev/train/screen_boxes.jsonl
!assets_dev/train/gt_corrections.jsonl
# 프로파일 에디터가 쓰는 덮어쓰기 — 사람이 실촬과 대조해 정한 값이 여기
# 쌓인다(synth_overrides.py 머리말). 기계가 쓴 파일이지만 담긴 것은 사람의
# 판단이라 잃으면 다시 못 만든다. 값이 굳으면 synth_profiles.py 로 옮긴다.
!assets_dev/train/synth_overrides.json
# 사람이 그린 라벨은 전부 추적한다 — 노동이 들어간 것이고 다시 만들 수 없다.
!assets_dev/train/band_boxes.jsonl
# 기종 태그(성분→기기)도 같은 사정: by:agent 1차 + 사람 확인(by:human)이
# 섞이는 라벨이라 웹툰 검토가 진행되면 재생 불가능해진다(G34).
!assets_dev/train/device_tags.jsonl
# 극성 정답 30장(2026-09-13) — 사람이 블라인드로 찍은 라벨. 자(measure_polarity)
# 의 배경 정의를 채점하는 유일한 기준이라 다시 만들 수 없다.
!assets_dev/train/polarity_gt.jsonl
# 사진 단위 기종 라벨 — 사람이 한 장씩 확인해 붙인 라벨의 정본이다.
# device_tags.jsonl 은 여기서 파생되는 요약이라 이걸 잃으면 요약도 못 되살린다.
!assets_dev/train/device_labels.jsonl
# 로보플로우 이물 태그(2026-09-21) — 첫 줄 _meta 가 태그 규약의 정본이고
# 사람이 채우는 판정 기록이라 다시 만들 수 없다(rf_split 과 같은 사정).
!assets_dev/train/rf_foreign_tags.jsonl
# 로보플로우 밴드 라벨 우리 규약(2026-09-22 rand 50장) — 사람이 손으로 그린
# 측정 정본 표본. 노동이 들어갔고 다시 만들 수 없다(band_boxes.jsonl 과 같은 사정).
!assets_dev/train/rf_band_boxes.jsonl
!assets_dev/train/fonts/
# 작업 목록. lcd_fix_holdout 은 특히 중요하다 — "이 장들은 학습에 쓰지 않는다"는
# 약속이라, 잃어버리면 다음 재학습이 테스트 셋을 먹고 실험이 조용히 무효가 된다.
!assets_dev/train/band_pilot.json
!assets_dev/train/lcd_fix_queue.json
!assets_dev/train/lcd_fix_holdout.json
assets_dev/train/__pycache__/
*.onnx
*.pth
*.pt
*.traineddata

# 서명 / 시크릿
.env
*.keystore
*.jks
android/key.properties
ios/Runner/GoogleService-Info.plist

# Supabase 접속 정보 (--dart-define-from-file 로 넘기는 로컬 파일)
*.local.json

# Supabase CLI 링크 상태 (프로젝트 ref 등)
supabase/.temp/

# Windows 데스크톱 타깃은 l10n·UI 미리보기용으로만 만든다(제품 타깃 아님).
# 재생성 방법은 docs/IMPLEMENTATION_PLAN.md 참조.
/windows/

# ZCode 세션 상태(계획 문서 등) — 기계 로컬이므로 버전 관리하지 않는다.
.zcode/
